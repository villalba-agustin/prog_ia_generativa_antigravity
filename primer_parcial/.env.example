PROJECT_NAME="Liga de Barrios y Fincas"
ENVIRONMENT="development"

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=liga_barrios
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database connection URL (asyncpg for FastAPI, psycopg2 for sync migrations if needed)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/liga_barrios
# SQLite fallback for quick testing if Postgres service is offline
SQLITE_FALLBACK=true

# Security & JWT
JWT_SECRET=liga_barrios_y_fincas_super_secret_jwt_key_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials
INITIAL_ADMIN_EMAIL=admin@ligabarrios.com
INITIAL_ADMIN_PASSWORD=admin1234

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8000"]
